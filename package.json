{
  "name": "lanka-kit",
  "version": "1.1.0",
  "type": "module",
  "description": "The Ultimate Sri Lankan Developer Toolkit: Identity (NIC, Driving License, Passport, TIN, BRN), Mobile Telco, Banking & Branch Codes, LKR Currency Words, Geo & LankaQR",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
